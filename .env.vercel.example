# Reference only: configure each group in its matching Vercel environment scope.
# Never upload a production URL/secret into Preview or Development.
# VERCEL_ENV is supplied by Vercel; do not define or override it yourself.

# Preview scope ONLY (use a separate Supabase project)
PREVIEW_DATABASE_URL=
PREVIEW_DATABASE_ID=

# Production scope ONLY (use the production Supabase project)
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_ID=

# Set independently in each scope; use different SECRET_KEY values.
SECRET_KEY=
GEMINI_API_KEY=
STUDY_MODE=study
TRIALS_PER_CONDITION=4
MAX_FOLLOWUPS=3
COOKIE_SECURE=1

# Optional local Postgres testing only; use a database marked local.
# APP_ENV=local
# LOCAL_DATABASE_URL=
# LOCAL_DATABASE_ID=
