# Export these variables in your shell or configure them in your process manager.
# The application does not automatically load .env files.
SECRET_KEY=replace-with-at-least-32-random-characters
STUDY_MODE=demo
STUDY_DATABASE=instance/demo.sqlite3
TRIALS_PER_CONDITION=4
MAX_FOLLOWUPS=3
COOKIE_SECURE=0
# Required in study mode. Never commit a real key.
GEMINI_API_KEY=

# Supabase: keep APP_ENV=local for SQLite. See docs/VERCEL_SUPABASE.md.
# ADMIN URLs are owner-only; never configure them in Vercel.
APP_ENV=local
PREVIEW_DATABASE_URL=
PREVIEW_DATABASE_ID=
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_ID=
PREVIEW_ADMIN_DATABASE_URL=
PRODUCTION_ADMIN_DATABASE_URL=
