{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/prepare_static.py",
  "functions": {
    "wsgi.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,instance/**,exports/**,backups/**,.env*,.venv/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
